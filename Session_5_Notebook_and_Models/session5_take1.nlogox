<model version="NetLogo 7.0.3" snapToGrid="true">
  <code>; Session 5 teaching reconstruction of Wilensky &amp; Reisman rule summaries.
; Implementation choices are documented in the notebook.
globals [ take-number sheep-gain-from-food wolf-gain-from-food
          move-cost seed-value max-ticks population-cap stop-reason ]
breed [ sheep a-sheep ]
breed [ wolves wolf ]
turtles-own [ energy ]
patches-own [ countdown ]

to setup
  clear-all
  set take-number 1
  set seed-value 2026
  random-seed seed-value
  set sheep-gain-from-food 4
  set wolf-gain-from-food 20
  set move-cost 1
  set max-ticks 1500
  set population-cap 20000
  set stop-reason "running"
  ask patches [ set pcolor brown set countdown 0 ]
  if take-number = 2 [
    ask n-of (floor (count patches / 2)) patches [ set pcolor green ]
    ask patches with [pcolor = brown] [
      set countdown random (max (list 1 grass-regrowth-time))
    ]
  ]
  if take-number = 3 [
    if initial-number-sheep &gt; count patches or initial-number-wolves &gt; count patches [
      error "Each initial species must fit into the patch world."
    ]
  ]
  create-sheep initial-number-sheep [
    set shape "sheep" set color white set size 1
    set energy random sheep-gain-from-food
    ifelse take-number = 3
      [ move-to one-of patches with [not any? sheep-here] ]
      [ move-to one-of patches ]
  ]
  create-wolves initial-number-wolves [
    set shape "wolf" set color black set size 1.3
    set energy random wolf-gain-from-food
    ifelse take-number = 3
      [ move-to one-of patches with [not any? wolves-here] ]
      [ move-to one-of patches ]
  ]
  reset-ticks
end

to go
  if ticks &gt;= max-ticks [ set stop-reason "time limit" stop ]
  if not any? turtles [ set stop-reason "no animals" stop ]
  if count turtles &gt;= population-cap [ set stop-reason "population safety cap" stop ]
  ; ask uses a random order within each breed; sheep act before wolves.
  ask sheep [ sheep-step ]
  ask wolves [ wolf-step ]
  if take-number = 2 [ ask patches [ grow-grass ] ]
  tick
end

to sheep-step
  ifelse take-number = 3
    [ let target one-of neighbors with [not any? sheep-here]
      if target != nobody [ move-to target ] ]
    [ move-to one-of neighbors ]
  if take-number = 2 [
    set energy energy - move-cost
    if pcolor = green [
      set pcolor brown
      set countdown grass-regrowth-time
      set energy energy + sheep-gain-from-food
    ]
    if energy &lt; 0 [ die ]
  ]
  if random-float 100 &lt; sheep-reproduce [
    ifelse take-number = 3
      [ let target one-of neighbors with [not any? turtles-here]
        if target != nobody [ hatch 1 [ move-to target ] ] ]
      [ if take-number = 2 [ set energy energy / 2 ]
        hatch 1 [ move-to one-of neighbors ] ]
  ]
end

to wolf-step
  ifelse take-number = 3
    [ let target one-of neighbors with [not any? wolves-here]
      if target != nobody [ move-to target ] ]
    [ move-to one-of neighbors ]
  ; Energy costs apply even if a crowded wolf cannot move (W2 step 2).
  set energy energy - move-cost
  let prey one-of sheep-here
  if prey != nobody [ ask prey [ die ] set energy energy + wolf-gain-from-food ]
  if energy &lt; 0 [ die ]
  if random-float 100 &lt; wolf-reproduce [
    ifelse take-number = 3
      [ let target one-of neighbors with [not any? wolves-here]
        if target != nobody [
          set energy energy / 2
          hatch 1 [ move-to target ]
        ] ]
      [ set energy energy / 2
        hatch 1 [ move-to one-of neighbors ] ]
  ]
end

to grow-grass
  if pcolor = brown [
    set countdown countdown - 1
    if countdown &lt;= 0 [ set pcolor green ]
  ]
end

to-report land_with_grass
  if take-number != 2 [ report 0 ]
  report 100 * count patches with [pcolor = green] / count patches
end

to-report occupancy-ok?
  report not any? patches with [count sheep-here &gt; 1 or count wolves-here &gt; 1]
end
</code>
  <widgets>
    <view x="416" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-25" height="579" showTickCounter="true" patchSize="11.275" fontSize="14" wrappingAllowedY="true" width="579" tickCounterLabel="ticks" maxPycor="25" updateMode="1" maxPxcor="25" minPxcor="-25" />
    <plot x="35" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="pop." y="395" xMin="0.0" height="192" legend="true" xMax="100.0" yMin="0.0" xAxis="time" display="populations" width="340" sizeVersion="0">
      <setup />
      <update />
      <pen interval="1.0" mode="0" display="sheep" color="-612749" legend="true">
        <setup />
        <update>plot count sheep</update>
      </pen>
      <pen interval="1.0" mode="0" display="wolves" color="-16449023" legend="true">
        <setup />
        <update>plot count wolves</update>
      </pen>
      <pen interval="1.0" mode="0" display="grass" color="-15302303" legend="true">
        <setup />
        <update>plot land_with_grass</update>
      </pen>
    </plot>
    <monitor x="255" precision="2" y="320" height="60" fontSize="11" display="land_with_grass" width="117" sizeVersion="0">land_with_grass</monitor>
    <monitor x="44" precision="3" y="320" height="60" fontSize="11" display="sheep" width="100" sizeVersion="0">count sheep</monitor>
    <monitor x="149" precision="3" y="320" height="60" fontSize="11" display="wolves" width="100" sizeVersion="0">count wolves</monitor>
    <slider x="215" step="1.0" y="240" max="100" display="wolf-reproduce" height="50" min="0.0" direction="Horizontal" default="5" variable="wolf-reproduce" units="%" width="165" sizeVersion="0" />
    <slider x="37" step="1.0" y="240" max="100" display="sheep-reproduce" height="50" min="1.0" direction="Horizontal" default="4" variable="sheep-reproduce" units="%" width="174" sizeVersion="0" />
    <note x="250" y="210" backgroundDark="0" fontSize="11" width="113" markdown="false" height="18" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">Wolf settings</note>
    <note x="60" y="215" backgroundDark="0" fontSize="11" width="140" markdown="false" height="18" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">Sheep settings</note>
    <slider x="101" step="1" y="79" max="300" display="grass-regrowth-time" height="50" min="1" direction="Horizontal" default="30" variable="grass-regrowth-time" width="212" sizeVersion="0" />
    <slider x="30" step="1" y="22" max="1000" display="initial-number-sheep" height="50" min="0" direction="Horizontal" default="100" variable="initial-number-sheep" width="174" sizeVersion="0" />
    <slider x="210" step="1" y="22" max="1000" display="initial-number-wolves" height="50" min="0" direction="Horizontal" default="100" variable="initial-number-wolves" width="165" sizeVersion="0" />
    <button x="210" y="145" height="40" disableUntilTicks="true" forever="true" kind="Observer" display="go" width="75" sizeVersion="0">go</button>
    <button x="135" y="145" height="40" disableUntilTicks="false" forever="false" kind="Observer" display="setup" width="69" sizeVersion="0">setup</button>
  </widgets>
  <info>## SESSION 5 TAKE 1
Teaching reconstruction; see accompanying notebook for paper mapping and implementation choices.
Sheep act before wolves; movement is to one of eight adjacent patches; world wraps.
Setup uses seed 2026. To change seed after setup: random-seed 2027.
Defaults illustrate mechanisms, not fitted historical populations.
Stop: 1500 ticks, no animals, or 20,000 animals (computational safety cap).
Grass percentage is meaningful only in Take 2.

## CREDIT AND LICENSE
Derived from Wilensky (1997), NetLogo Wolf Sheep Predation, and the teaching adaptation
by Jose Manuel Magallanes. Rule sequence: Wilensky &amp; Reisman (2006).
Original copyright 1997 Uri Wilensky. Distributed under CC BY-NC-SA 3.0:
https://creativecommons.org/licenses/by-nc-sa/3.0/
</info>
